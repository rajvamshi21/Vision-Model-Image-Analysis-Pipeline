# ---- storage -------------------------------------------------------------
VQA_DATABASE_URL=postgresql://vqa:vqa@localhost:5433/vqa

# ---- embeddings ----------------------------------------------------------
# openclip -> local CLIP/SigLIP weights (pip install "vqa[models]")
# hash     -> dependency-free perceptual encoder (default, no downloads)
VQA_EMBEDDING_BACKEND=hash
VQA_EMBEDDING_MODEL=ViT-B-32
VQA_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
VQA_EMBEDDING_DIM=512
VQA_DEVICE=auto

# ---- multimodal critique (optional) --------------------------------------
# none | anthropic | openai
VQA_VLM_PROVIDER=none
VQA_VLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- runtime -------------------------------------------------------------
VQA_BATCH_SIZE=16
VQA_MAX_WORKERS=8
VQA_MAX_SIDE=1024
